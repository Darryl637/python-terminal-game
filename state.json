    "537e52ef-4cbd-44ff-ad32-fdc2429183c8": {
      "areatype": "",
      "name": "Coruscant Galactic Academy - Flight Simulator",
      "desc": "Rows of advanced flight simulators line the expansive training hall, each\nprojecting holographic starfields and distant worlds. Cadets practice takeoffs,\ndocking maneuvers, and hyperspace navigation under the watchful eyes of\nexperienced instructors. The steady hum of engines and computer systems fills\nthe room, reminding every recruit that mastering a starship is the first step\ntoward exploring the galaxy.",
      "actions": {
        "down": {
          "action": "gotoroom",
