    "ad3e950d-1cf5-4d92-ae4e-bd61e5713093": {
      "areatype": "",
      "name": "Coruscant Galactic Academy - Engineering Lab",
      "desc": "Workbenches filled with tools, circuit boards, and dismantled droids line the\nwalls of the Engineering Lab. Students carefully assemble components while\ninstructors demonstrate the principles of repair, fabrication, and maintenance.\nThe occasional burst of sparks and the whir of diagnostic equipment fill the\nair, reminding every recruit that a skilled engineer can keep both machines and\nstarships running when it matters most.",
      "actions": {
        "west": {
          "action": "gotoroom",
          "room_id": "vnum0"
        }
      },
