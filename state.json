    "bb988e81-b58c-409c-a35e-787b73017a2f": {
      "areatype": "",
      "name": "Coruscant Galactic Academy - Entrance Plaza",
      "desc": "A broad plaza stretches before the Academy, its polished stone alive with the\nfootsteps of students, travelers, and instructors. Speeders weave through the\ntraffic lanes high overhead while distant city sounds echo between towering\nskyscrapers. The Academy's towering entrance stands to the north, welcoming\nthose eager to begin their journey, while the streets of Coruscant continue\nsouth into the heart of the endless city.",
      "actions": {
        "north": {
          "action": "gotoroom",
          "room_id": "vnum0"
        },
