    "f00a3557-cb49-4b9e-a9cc-5a35d7fb5fe0": {
      "areatype": "",
      "name": "Coruscant Galactic Academy - Cafeteria",
      "desc": "Long rows of tables fill the Academy Cafeteria as students and instructors pause\nbetween lessons to share meals and conversation. The aroma of freshly prepared\nfood drifts from serving stations where droids work tirelessly to keep hungry\nrecruits fed. Laughter, friendly debate, and the occasional boast about\nsimulator scores create a welcome contrast to the disciplined atmosphere found\nelsewhere in the Academy.",
