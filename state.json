    },
    "12612dd2-13fc-40bb-a988-6ac9d50f6b93": {
      "areatype": "",
      "name": "Coruscant Galactic Academy - Combat Annex",
      "desc": "Reinforced walls and padded training areas fill the Combat Annex, where recruits\nhone their skills in controlled exercises. Practice remotes drift through the\nroom while training droids spar with cadets under the supervision of seasoned\ninstructors. The sharp crack of stun bolts and the clash of practice weapons\necho through the hall, reminding every student that discipline and preparation\nare as valuable as strength in battle.",
